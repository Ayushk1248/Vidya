NEXT_PUBLIC_SUPABASE_URL=
# Use the public publishable key, or the legacy public anon key below.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Run npm run init to create a local encryption key.

# Origin placed in new certificate QR links. Use your deployed HTTPS origin for sharing.
PLATFORM_PUBLIC_ORIGIN=http://localhost:3001

# Explicit local synthetic demo. Ignored in production.
VIDYA_DEMO_MODE=0
# Optional local service port override (default 8001).
VALIDATION_SERVICE_URL=http://127.0.0.1:8001
# SMTP delivery. Keep real credentials in ignored .env.local only.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Comma-separated HTTPS webhook host allowlist. Private IP destinations are rejected.
PLATFORM_WEBHOOK_HOSTS=
# Use a separate secret and store exported checkpoints off this machine.
AUDIT_CHECKPOINT_KEY=
